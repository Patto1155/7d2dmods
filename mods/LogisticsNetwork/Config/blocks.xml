<configs>
  <append xpath="/blocks">

    <block name="logisticsConduit">
      <property name="Class" value="LogisticsNetwork.Blocks.LogisticsConduitBlock, LogisticsNetwork"/>
      <property name="Material" value="Mmetal_weak"/>
      <property name="Group" value="Building,Basics"/>
      <property name="DescriptionKey" value="logisticsConduitDesc"/>
      <property name="Shape" value="ModelEntity"/>
      <property name="Model" value="@:Entities/Industrial/conduitPipeMetal_05Prefab.prefab"/>
      <property name="Stacknumber" value="200"/>
      <property name="EconomicValue" value="10"/>
    </block>

    <block name="logisticsConnector">
      <property name="Class" value="LogisticsNetwork.Blocks.LogisticsConnectorBlock, LogisticsNetwork"/>
      <property name="Material" value="Mmetal_weak"/>
      <property name="Group" value="Building,Basics"/>
      <property name="DescriptionKey" value="logisticsConnectorDesc"/>
      <property name="Shape" value="ModelEntity"/>
      <property name="Model" value="@:Entities/Industrial/conduitPipeMetal_05Prefab.prefab"/>
      <property name="Stacknumber" value="64"/>
      <property name="EconomicValue" value="25"/>
    </block>

  </append>
</configs>
