<configs>
  <append xpath="/blocks">

    <block name="autoForgeWorkstation">
      <property name="Class" value="AutoForgeBlock, AutoForge"/>
      <property name="Material" value="Mmetal_weak"/>
      <property name="Group" value="Building,Basics"/>
      <property name="DescriptionKey" value="autoForgeWorkstationDesc"/>
      <property name="CustomIcon" value="workbench"/>
      <property name="Shape" value="ModelEntity"/>
      <property name="Model" value="@:Entities/Crafting/woodWorkBenchPrefab.prefab"/>
      <property name="ModelOffset" value="0,.5,0"/>
      <property name="Stacknumber" value="10"/>
      <property name="EconomicValue" value="2000"/>
    </block>

    <block name="autoForgeConduit">
      <property name="Class" value="ConduitBlock, AutoForge"/>
      <property name="Material" value="Mmetal_weak"/>
      <property name="Group" value="Building,Basics"/>
      <property name="DescriptionKey" value="autoForgeConduitDesc"/>
      <property name="Shape" value="ModelEntity"/>
      <property name="Model" value="@:Entities/Industrial/conduitPipeMetal_05Prefab.prefab"/>
      <property name="Stacknumber" value="200"/>
      <property name="EconomicValue" value="10"/>
    </block>

  </append>
</configs>
